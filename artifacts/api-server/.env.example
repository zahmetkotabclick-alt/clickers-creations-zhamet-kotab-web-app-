PORT=5000
ALLOWED_ORIGIN=http://localhost:3000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Telegram Order Notifications Configuration (Backend Only)
# 1. Create a bot with @BotFather to get your token
# 2. Add the bot to your private orders group and obtain group chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Connection URL (Optional direct PostgreSQL pool)
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Paymob Payment Webhook HMAC Secret
# PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
